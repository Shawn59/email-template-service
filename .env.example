# Логин для входа в админку (сравнивается с полем «Логин» на форме)
LOGIN=change-me

# Пароль для входа (сравнивается с полем «Пароль» на форме)
PASSWORD=change-me

# Секрет для подписи JWT. Должен быть длинным и случайным; без него нельзя подделать cookie
JWT_SECRET=change-me-to-a-long-random-secret

# Порт HTTP-сервера Fastify
PORT=3000

# Хост, на котором слушает сервер (0.0.0.0 — доступен из сети)
HOST=0.0.0.0

# Окружение: development | production | test (влияет на Secure у cookie и логи)
NODE_ENV=development

# Уровень логов Fastify: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Разрешённые origin для CORS (через запятую, если несколько). Нужен для cookie с фронта
CORS_ORIGIN=http://localhost:5173

# Имя httpOnly cookie, в которой хранится JWT
COOKIE_NAME=auth_token

# Срок жизни JWT/cookie: число + единица (s|m|h|d), например 7d, 24h, 3600s
JWT_EXPIRES_IN=7d
